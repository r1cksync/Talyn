# Local demo only. AWS tasks receive secrets from Secrets Manager.
TALYN_MODE=demo
TALYN_ENVIRONMENT=development
TALYN_DATABASE_URL=sqlite:///./.local/talyn.db
TALYN_PUBLIC_URL=http://localhost:3000
TALYN_REGION=ap-south-1
TALYN_RUN_DEMO_WORKER=true
TALYN_LLM_PROVIDER=bedrock
# User-approved external LLM alternative: groq. Demo remains deterministic with either setting.
# AWS Groq deployments inject TALYN_GROQ_API_KEY from Secrets Manager, never browser code.
# TALYN_GROQ_MODEL_ID=openai/gpt-oss-20b
TALYN_LIVE_EMAIL=false
TALYN_EMAIL_ALLOWLIST=success@simulator.amazonses.com
# AWS mode requires COGNITO_POOL_ID, COGNITO_CLIENT_ID, BUCKET, QUEUE_URL,
# DATABASE_SECRET_ARN, DATABASE_HOST, SESSION_SECRET and HTTPS PUBLIC_URL.
